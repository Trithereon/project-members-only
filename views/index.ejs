<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <button class="sign-up" data-id="signUp" data-action="toggleForm">
      Sign up
    </button>
    <% if (locals.visibleForm === "signUpForm") { %>
    <%- include("./partials/signUpForm", {data: data, visible: true, errors: errors}) %>
    <% } else { %>
    <%- include("./partials/signUpForm", {data: false, visible: false, errors: false}) %>
    <% } %>

    <div class="main-content">
      <% messages.forEach((message)=>{ %>
      <div class="message-block">
        <h2 class="message-title"><%= message.title %></h2>
        <div class="message-text"><%= message.text %></div>
        <button
          class="delete-btn"
          data-action="deletemessage"
          data-id="<%= message.id %>"
        >
          Delete message
        </button>
        <button
          class="edit-btn"
          data-action="toggleForm"
          data-id="editMessageForm-<%= message.id %>"
        >
          Edit message
        </button>
        <% if (locals.visibleForm === `editForm-${message.id}`) { %>
        <%- include("./partials/editMessageForm", {message: message, visible: true, errors: errors}) %>
        <% } else { %>
        <%- include("./partials/editMessageForm", {message: message, visible: false, errors: false}) %>
        <% } %>
      </div>
      <% }) %>
    </div>

    <%- include("./partials/footer") %>
  </body>
</html>
