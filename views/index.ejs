<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>

    <% if (locals.currentUser) {%>
    <h2>
      Welcome back,
      <%= currentUser.firstname %>
      <%= currentUser.lastname %>
      (<%= currentUser.username %>)
    </h2>
    <% if (!locals.currentUser.admin_status) { %>
    <a class="become-admin-btn" href="/become-admin"> Become an admin </a>
    <% } else { %>
    <span>Admin status: active</span>
    <% } %>
    <% if (!locals.currentUser.membership_status) { %>
    <a class="join-the-club-btn" href="/join-the-club"> Join the club </a>
    <% } else { %>
    <span>Membership status: active</span>
    <% } %>
    <a href="/logout">Log out</a>
    <% } else { %>
    <button class="sign-up" data-id="signUp" data-action="toggleForm">
      Sign up
    </button>
    <% if (locals.visibleForm === "signUp") { %>
    <%- include("./partials/signUpForm", {data: data, visible: true, errors: errors}) %>
    <% } else { %>
    <%- include("./partials/signUpForm", {data: false, visible: false, errors: false}) %>
    <% } %>
    <button class="login" data-id="login" data-action="toggleForm">
      Log in
    </button>
    <% if (locals.visibleForm === "login") { %>
    <%- include("./partials/loginForm", {visible: true, errors: errors}) %>
    <% } else { %>
    <%- include("./partials/loginForm", {visible: false, errors: false}) %>
    <% } %>
    <%}%>
    <div class="main-content">
      <% if (locals.currentUser) { %>
      <a href="/create-message">Create new message</a>
      <% } %>
      <% messages.forEach((message)=>{ %>
      <div class="message-block">
        <h2 class="message-title"><%= message.title %></h2>
        <div class="message-text"><%= message.text %></div>
        <% if (locals.currentUser && locals.currentUser.membership_status) { %>
        <div class="message-author">- <%= message.username %></div>
        <div class="message-created-at"><%= message.created_at %></div>
        <% } else { %>
        <div class="message-author">- Anonymous</div>
        <% } %>
        <% if (locals.currentUser && locals.currentUser.admin_status) { %>
        <form
          method="POST"
          class="visible delete"
          action="/delete/message/<%= message.id %>?_method=DELETE"
        >
          <button class="delete-btn" type="submit">Delete message</button>
        </form>
        <% } %>
      </div>
      <% }) %>
    </div>

    <%- include("./partials/footer") %>
  </body>
</html>
