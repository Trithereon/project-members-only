<form 
id="editMessageForm-<%= message.id %>"
action="/edit/message/<%= message.id %>" 
method="POST" 
class="<%= visible ? 'visible' : ''%>" 
<%= errors ? "data-errored" : "" %>
>
  <%- include("./validationErrors") %>

  <label for="title">Title: </label>
  <input
    type="text"
    name="title"
    id="title"
    value="<%= locals.data ? locals.data.title : '' %>"
  />
  <label for="text">Message: </label>
  <input
    type="text"
    name="text"
    id="text"
    value="<%= locals.data ? locals.data.text : '' %>"
  />
  <button type="submit">Submit</button>
</form>
